# Copy to .env. Scripts run through dotenvx, which accepts either form below.

# Client ID from your EVE developer application (https://developers.eveonline.com).
# This is a PKCE public client — the ID is not a secret.
EVE_CLIENT_ID=your_client_id_here

# Alternatively, a 1Password secret reference. Requires the `op` CLI, signed in.
# EVE_CLIENT_ID="op://vault/item/EVE_CLIENT_ID"

# Optional. Defaults to http://localhost:1421/callback in dev.
# EVE_CALLBACK_URL=http://localhost:1421/callback
